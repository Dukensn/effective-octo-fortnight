<template>
  <style>
    @font-face { font-family: "Inter"; src: url("assets/fonts/Inter-Regular.otf"); font-weight: 400; font-display: block; }
    @font-face { font-family: "Inter"; src: url("assets/fonts/Inter-Medium.otf"); font-weight: 500; font-display: block; }
    @font-face { font-family: "Inter"; src: url("assets/fonts/Inter-SemiBold.otf"); font-weight: 600; font-display: block; }
    @font-face { font-family: "Inter"; src: url("assets/fonts/Inter-Bold.otf"); font-weight: 700; font-display: block; }
    @font-face { font-family: "Inter"; src: url("assets/fonts/Inter-ExtraBold.otf"); font-weight: 800; font-display: block; }
    @font-face { font-family: "InterD"; src: url("assets/fonts/InterDisplay-Black.otf"); font-weight: 900; font-display: block; }

    #root { position: relative; width: 1080px; height: 1920px; overflow: hidden; -webkit-font-smoothing: antialiased; }

    /* le prix, écrit pendant tout le film (le client ne le dit pas à la voix) */
    #pb-wrap { position: absolute; left: 0; top: 1662px; width: 1080px; display: flex; justify-content: center; }
    #pb-pill { position: relative; height: 82px; padding: 0 32px 0 14px; border-radius: 41px; display: flex; align-items: center; gap: 18px;
      background: linear-gradient(165deg, #FFFFFF, #F8F6F2); box-shadow: 0 18px 40px rgba(40,30,20,.16), 0 2px 6px rgba(40,30,20,.08), inset 0 1px 0 #fff; }
    #pb-tag { height: 56px; padding: 0 18px; border-radius: 28px; background: #1B1A18; color: #FFFFFF; font: 800 24px/56px "Inter"; letter-spacing: 3px; }
    #pb-val { font: 800 44px/1 "Inter"; letter-spacing: -0.8px; color: #1B1A18; white-space: nowrap; }
    #pb-ring { position: absolute; left: -6px; top: -6px; right: -6px; bottom: -6px; border-radius: 47px; border: 4px solid #D97757; opacity: 0; }
    #pb-sheen { position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 41px; overflow: hidden; }
    #pb-sheen div { position: absolute; top: -20px; left: 0; width: 70px; height: 140px; transform: translateX(-120px) rotate(18deg);
      background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.85), rgba(255,255,255,0)); }
  </style>

  <div id="root" data-composition-id="pri-badge" data-width="1080" data-height="1920" data-duration="@TOTAL@">
    <div id="pb-clip" class="clip" data-start="0" data-duration="@TOTAL@" data-track-index="0">
      <div id="pb-wrap">
        <div id="pb-pill" style="opacity:0;">
          <div id="pb-sheen"><div></div></div>
          <div id="pb-tag">PRI</div>
          <div id="pb-val">95 dola US</div>
          <div id="pb-ring"></div>
        </div>
      </div>
    </div>
  </div>

  <script src="assets/vendor/gsap.min.js"></script>
  <script>
    (function () {
      var FID = "pri-badge", T = @TOTAL@;
      var tl = gsap.timeline({ paused: true });
      /* 0.40 : le badge tombe, trop grand et flou, se pose */
      tl.fromTo("#pb-pill", { opacity: 0, y: 24, scale: 1.25, filter: "blur(8px)" }, { opacity: 1, y: 0, scale: 1, filter: "blur(0px)", duration: 0.18, ease: "expo.out" }, 0.40);
      /* rappel toutes les 12 s : reflet + anneau accent (vies finies, pas de repeat infini) */
      for (var t = 6; t < T - 1; t += 12) {
        tl.fromTo("#pb-sheen div", { x: -120 }, { x: 520, duration: 0.7, ease: "power2.inOut", immediateRender: false }, t);
        tl.fromTo("#pb-ring", { opacity: 0.9, scale: 1 }, { opacity: 0, scale: 1.18, duration: 0.6, ease: "expo.out", immediateRender: false }, t + 0.1);
        tl.to("#pb-pill", { scale: 1.05, duration: 0.12, ease: "power2.out", yoyo: true, repeat: 1 }, t + 0.1);
      }
      tl.to({}, { duration: T }, 0);
      window.__timelines = window.__timelines || {};
      window.__timelines[FID] = tl;
    })();
  </script>
</template>
