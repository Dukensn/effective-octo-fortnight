# Copiez ce fichier en .env.local puis remplissez avec la configuration Firebase
# (Console Firebase > Paramètres du projet > Vos applications > Config SDK).
# Si ces variables sont vides, l'application fonctionne en mode local (hors ligne) uniquement.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
